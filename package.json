{
  "name": "wildix-closest-location",
  "version": "1.0.0",
  "description": "UK Postcode webhook service to find closest Wildix store/branch location and retrieve drive time via Google Maps API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node dist/tests/run-tests.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "wildix",
    "google-maps",
    "postcode",
    "closest-location",
    "drive-time",
    "webhook",
    "uk"
  ],
  "author": "Wildix",
  "license": "MIT"
}
